# ==========================================================
# СЖАТИЕ (мгновенная загрузка текста/стилей/скриптов)
# ==========================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css \
        text/javascript application/javascript application/json \
        application/xml image/svg+xml
</IfModule>

# ==========================================================
# ЗАГОЛОВКИ БЕЗОПАСНОСТИ
# ==========================================================
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "frame-ancestors 'none'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ==========================================================
    # 1. БЛОКИРОВКА AI-БОТОВ И IFRAME
    # ==========================================================
    RewriteCond %{HTTP_USER_AGENT} (ChatGPT-User|GPTBot|ChatGPT|ClaudeBot|Claude-Web|AnthropicAI|PerplexityBot|ImagesiftBot|Omgilibot|Omgfi|CohereBot|cohere-ai|Diffbot|DataForSeoBot|Meta-ExternalAgent|Google-Extended|GoogleBot-Image|GoogleBot-Video|Google-CloudVertexBot|YouBot|YandexBot|Applebot-Extended|CommonCrawl|CCBot|KangarooBot|Scrapy|TencentTraveler|PetalBot|LinkUpBot|ByteSpider|Bytespider|Amazonbot|Webzio-Extended|Meltwater|magpie-crawler|FacebookBot) [NC,OR]
    RewriteCond %{HTTP_SEC_FETCH_DEST} ^iframe$ [NC]
    RewriteRule ^ - [F,END]

    # ==========================================================
    # 2. СНЯТИЕ .php С ВНЕШНИХ URL
    # ==========================================================
    # /q.php -> /q
    RewriteCond %{THE_REQUEST} \s/+q\.php(?:[?\s]) [NC]
    RewriteRule ^q\.php$ /q [R=301,END,NE]

    # любой_файл.php -> любой_файл
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]) [NC]
    RewriteRule ^(.+)\.php$ /$1 [R=301,END,NE]

    # ==========================================================
    # 3. РЕДИРЕКТ ДОМЕНА И ПОДДОМЕНА НА /q
    # ==========================================================
    # monetization.site/  ИЛИ  forum.monetization.site/  ->  /q
    # RewriteCond %{HTTP_HOST} ^(www\.)?monetization\.site$ [NC,OR]
    # RewriteCond %{HTTP_HOST} ^forum\.monetization\.site$ [NC]
    # RewriteCond %{REQUEST_URI} ^/?$
    # RewriteRule ^ /q [R=302,END,NE]
    # ==========================================================
    # 3. РЕДИРЕКТ ТОЛЬКО ПОДДОМЕНА НА /q
    # ==========================================================
    # forum.monetization.site/  ->  forum.monetization.site/q
    RewriteCond %{HTTP_HOST} ^forum\.monetization\.site$ [NC]
    RewriteCond %{REQUEST_URI} ^/?$
    RewriteRule ^(.*)$ /q [R=302,L,NE]

    # ==========================================================
    # 4. ВНУТРЕННИЙ МАППИНГ: /q -> q.php (главная)
    # ==========================================================
    RewriteRule ^q/?$ q.php [END]

    # ==========================================================
    # 5. ОТКРЫТИЕ PHP-ФАЙЛОВ БЕЗ РАСШИРЕНИЯ
    # ==========================================================
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [END,QSA]

    # ==========================================================
    # 5.5. РЕДИРЕКТ /index.html -> quest.monetization.site
    # ==========================================================
    RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
    RewriteRule ^index\.html$ http://quest.monetization.site/ [R=301,END,NE]


    # ==========================================================
    # 6. НЕСУЩЕСТВУЮЩИЕ СТРАНИЦЫ (включая /a/b/c/d) -> /q
    # ==========================================================
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot|map|json)$ [NC]
    RewriteRule ^ /q [R=302,END,NE]
</IfModule>

# ==========================================================
# 7. NOINDEX ДЛЯ ВСЕГО, КРОМЕ /q (главной)
# ==========================================================
SetEnvIf Request_URI "^/q/?$" IS_MAIN
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=!IS_MAIN
    Header always set X-Robots-Tag "index, follow"               env=IS_MAIN
</IfModule>

# ==========================================================
# 8. Мгновенный 404 для статики (без запуска PHP)
# ==========================================================
ErrorDocument 404 "404 Not Found"
